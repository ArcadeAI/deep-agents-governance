# The agent's own environment. Copy to .env next to this file; `mda dev` and
# `mda deploy` read it. Values come from the root .env (`bun run setup-arcade`
# writes them there) and from your LangSmith workspace.

# --- Required -----------------------------------------------------------------
# Deploys and runs the agent on Managed Deep Agents (needs the MDA beta).
LANGSMITH_API_KEY=
# The same Arcade project key as the root .env.
ARCADE_API_KEY=
# The gateway setup-arcade created: tool selection is scoped to its nine tools.
ARCADE_GATEWAY_ID=
# The app's public origin with scheme, e.g. https://<APP_PUBLIC_HOST>. Its /jwks
# verifies callers.
LOAN_DESK_ISSUER=
# The app's web client, from the root .env. The id is the audience of the ID
# tokens callers send; ask.py signs in as this client, so it needs the secret.
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# --- Optional -----------------------------------------------------------------
# Where ask.py sends the run. Blank, `mda dev`'s local server.
# AGENT_URL=
# A real model instead of the scripted one. Needs `uv sync --extra anthropic`
# and the provider's key.
# MODEL_ID=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
