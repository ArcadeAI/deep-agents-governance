# The agent's own environment. Copy to .env next to this file; `mda dev` and
# `mda deploy` read it. In the workshop every value below comes from the attendee
# portal: step 2 for the two LangSmith keys, step 3 for the Arcade key, step 4 for
# the identity values. Outside the workshop the root .env has the Arcade and
# identity values (`bun run okta-setup` and `bun run setup-arcade` write them).

# --- Required: fill these in --------------------------------------------------
# Your own LangSmith key. Traces, the dataset, the experiments and the deployment
# land in its workspace, which needs Managed Deep Agents on.
LANGSMITH_API_KEY=
# The Arcade project key.
ARCADE_API_KEY=
# The identity provider, an Okta custom authorization server such as
# https://<org>.okta.com/oauth2/default, and the Okta app ask.py signs in as.
IDP_ISSUER=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
# The model, reached with no model key on this machine: every model call goes
# through the LangSmith LLM Gateway with the key below, the room's, whose
# workspace holds the provider key as a secret.
MODEL_ID=openai:gpt-5.5
LANGSMITH_GATEWAY=true
LANGSMITH_GATEWAY_API_KEY=

# --- Evals: evals/, portal steps 18 and 19 ------------------------------------
# Who the eval runs as: your own email, the one ask.py signs in as.
EVAL_LOAN_OFFICER=
# The tracing project this morning's runs are in. `mda dev` traces to loan-desk-local.
EVAL_PROJECT=loan-desk-local

# --- Optional -----------------------------------------------------------------
# A provider key instead of the gateway: set one and drop the two gateway lines.
# Its package goes in pyproject's dependencies, which is what `mda dev` and
# `mda deploy` build from. No MODEL_ID at all runs the scripted model, no key needed.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Where ask.py sends the run. Blank, `mda dev`'s local server.
# AGENT_URL=
# Your own email, for a room where the Okta sign-in is a shared persona: the loan
# desk runs as the persona, Gmail and Slack as this address. The same as `ask.py --as`.
# It must be the email of your Arcade account, invited to the project.
# CONNECTED_APPS_USER=
# The judge's model, in the notebook and in the online rule. Blank, MODEL_ID. The
# online rule reads its key from a workspace secret named LANGSMITH_GATEWAY_API_KEY.
# JUDGE_MODEL=
# The repo's own app, for audit rows beside a trace. In the workshop, live activity has them.
# APP_URL=http://localhost:3000
