{
  "id": "app-identity",
  "type": "oauth2",
  "description": "The Loans Approval Limits app's identity provider (hop 2)",
  "oauth2": {
    "client_id": "<IDP_CLIENT_ID>",
    "client_secret": "<IDP_CLIENT_SECRET>",
    "scope_delimiter": " ",
    "pkce": {
      "enabled": true,
      "code_challenge_method": "S256"
    },
    "authorize_request": {
      "endpoint": "<IDP_ISSUER>/v1/authorize",
      "params": {
        "response_type": "code",
        "client_id": "{{client_id}}",
        "redirect_uri": "{{redirect_uri}}",
        "scope": "{{scopes}} {{existing_scopes}}"
      }
    },
    "token_request": {
      "endpoint": "<IDP_ISSUER>/v1/token",
      "method": "POST",
      "auth_method": "client_secret_basic",
      "params": {
        "grant_type": "authorization_code",
        "redirect_uri": "{{redirect_uri}}"
      },
      "request_content_type": "application/x-www-form-urlencoded",
      "response_content_type": "application/json"
    },
    "user_info_request": {
      "endpoint": "<IDP_ISSUER>/v1/userinfo",
      "method": "GET",
      "auth_method": "bearer_access_token",
      "response_content_type": "application/json",
      "response_map": {
        "user_id": "$.email"
      },
      "triggers": {
        "on_token_grant": true,
        "on_token_refresh": false
      }
    }
  }
}
